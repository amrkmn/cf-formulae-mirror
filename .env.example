# GitHub token for fetching Homebrew artifact (required)
# Create at: https://github.com/settings/tokens (no scopes needed for public repo)
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Backblaze B2 credentials (required for sync)
B2_APPLICATION_KEY_ID=xxx
B2_APPLICATION_KEY=xxx

# B2 bucket name (required)
B2_BUCKET=YOUR_BUCKET_NAME

# Optional: override the GitHub artifact API URL
# ARTIFACT_API_URL=https://api.github.com/repos/Homebrew/formulae.brew.sh/actions/artifacts?name=github-pages

# Optional: override output directory (default: ./dist)
# OUTPUT_DIR=./dist

# Optional: override cache directory (default: XDG_CACHE_HOME/formulae-mirror-artifacts)
# CACHE_DIR=/path/to/cache
